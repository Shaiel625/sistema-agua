# Copia este archivo como ".env" (en la misma carpeta Backend/) y
# rellena los valores reales. NUNCA subas el archivo ".env" a git
# (ya está listado en .gitignore).

# ==========================
# Base de datos (Postgres)
# ==========================
# Ejemplo con Neon (gratis): crea un proyecto en https://neon.tech
# y copia el "Connection string" que te da.
DATABASE_URL=postgresql://usuario:password@host/nombre_db?sslmode=require

# ==========================
# MQTT (broker en la nube)
# ==========================
# Ejemplo con HiveMQ Cloud (gratis): crea un cluster en
# https://console.hivemq.cloud y copia el host que termina en
# ".s1.eu.hivemq.cloud" (o similar).
MQTT_HOST=xxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=tu_usuario_mqtt
MQTT_PASSWORD=tu_password_mqtt
MQTT_TOPIC=agua/lecturas
